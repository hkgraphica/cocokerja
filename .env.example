# --- Wajib ---
# Postgres (Neon/Supabase di Vercel; postgres lokal/VPS di docker-compose). Gunakan URL pooled di serverless.
DATABASE_URL=postgres://user:pass@host:5432/cocokerja
TELEGRAM_BOT_TOKEN=
# Acak >= 16 karakter: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# 32 byte base64: openssl rand -base64 32  (JANGAN diganti setelah ada data, CV lama tak bisa didekripsi)
ENCRYPTION_KEY=

# --- Opsional ---
# Sumber lowongan (RSS), pisahkan koma. Hanya pakai sumber yang mengizinkan pengambilan data.
JOB_FEEDS=
# Sumber legal: ATS publik per perusahaan + remotive. Format: greenhouse:slug,lever:slug,ashby:slug,remotive
JOB_SOURCES=greenhouse:xendit,lever:nium,ashby:airwallex,remotive
# LLM kompatibel OpenAI. Kosongkan untuk memakai skor heuristik saja.
LLM_BASE_URL=https://api.nexotao.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
# LLM Cadangan / Rotasi (Google Gemini OpenAI-compatible)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Batas waktu satu tick (ms). Vercel Hobby: tetap <= 45000.
TICK_BUDGET_MS=45000
# Hanya worker VPS
TICK_INTERVAL_MS=600000
DB_POOL_MAX=1
NEXT_PUBLIC_BOT_URL=https://t.me/NamaBotKamu
