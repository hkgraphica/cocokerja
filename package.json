{
  "name": "cocokerja",
  "version": "0.2.0",
  "private": true,
  "description": "AI Career Launcher + Job Alert (bot Telegram)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "set-webhook": "tsx --env-file=.env scripts/set-webhook.ts",
    "harvest": "tsx --env-file=.env scripts/harvest-telegram.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
